{
  "id": "/",
  "name": "Nexlyr Calculator",
  "short_name": "Nexlyr Calc",
  "description": "Scientific calculator, step-by-step equation solver, 2D and 3D graphing, 24 maths and student tools, an Earth & Geo calculator, a 20-game maths arcade and the Amy tutor. Free and works offline.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#2A2826",
  "theme_color": "#2A2826",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/icons/icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/icons/screens/wide-calculator.webp", "sizes": "1280x800", "type": "image/webp", "form_factor": "wide", "label": "Scientific calculator with frosted-glass keypad" },
    { "src": "/icons/screens/wide-geo.webp", "sizes": "1280x800", "type": "image/webp", "form_factor": "wide", "label": "Earth & Geo: distance, bearing and Qibla on a live globe" },
    { "src": "/icons/screens/wide-tools.webp", "sizes": "1280x800", "type": "image/webp", "form_factor": "wide", "label": "24 maths and student tools" },
    { "src": "/icons/screens/wide-graph.webp", "sizes": "1280x800", "type": "image/webp", "form_factor": "wide", "label": "Graphing in 2D and 3D" },
    { "src": "/icons/screens/narrow-calculator.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "Scientific calculator" },
    { "src": "/icons/screens/narrow-tools.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "All tools, each with its own colour" },
    { "src": "/icons/screens/narrow-geo.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "Earth & Geo calculator" },
    { "src": "/icons/screens/narrow-graph.webp", "sizes": "780x1688", "type": "image/webp", "form_factor": "narrow", "label": "Graphing calculator" }
  ],
  "shortcuts": [
    { "name": "Solve with steps", "short_name": "Solve", "url": "/solve/?source=pwa", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Graph", "url": "/graph/?source=pwa", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Earth & Geo", "short_name": "Geo", "url": "/tools/geo/?source=pwa", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Maths Arcade", "short_name": "Arcade", "url": "/arcade/?source=pwa", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
