{
  "version": 1,
  "note": "Checked formula list for the Formulas tool. Each 'expr' is solved by the app's own engine for whichever variable is left blank. 'ex' gives sample values for every variable except the first; tests/formulas-check.mjs solves the formula for each variable in turn and checks it gets the sample values back.",
  "groups": [
    { "id": "mensuration", "name": "Area, volume and shapes" },
    { "id": "trig", "name": "Trigonometry" },
    { "id": "coord", "name": "Coordinate geometry" },
    { "id": "algebra", "name": "Algebra, sequences and statistics" },
    { "id": "money", "name": "Money and percentages" },
    { "id": "mechanics", "name": "Physics: motion, forces and energy" },
    { "id": "electricity", "name": "Physics: electricity" },
    { "id": "waves", "name": "Physics: waves, light and heat" },
    { "id": "chemistry", "name": "Chemistry" }
  ],
  "formulas": [
    { "id": "rect-area", "g": "mensuration", "name": "Area of a rectangle", "tex": "A = lw", "expr": "A = l*w", "vars": [{ "s": "A", "n": "area" }, { "s": "l", "n": "length" }, { "s": "w", "n": "width" }], "ex": { "l": 8, "w": 3.5 } },
    { "id": "tri-area", "g": "mensuration", "name": "Area of a triangle", "tex": "A = \\tfrac{1}{2}bh", "expr": "A = 1/2*b*h", "vars": [{ "s": "A", "n": "area" }, { "s": "b", "n": "base" }, { "s": "h", "n": "perpendicular height" }], "ex": { "b": 10, "h": 6 } },
    { "id": "para-area", "g": "mensuration", "name": "Area of a parallelogram", "tex": "A = bh", "expr": "A = b*h", "vars": [{ "s": "A", "n": "area" }, { "s": "b", "n": "base" }, { "s": "h", "n": "perpendicular height" }], "ex": { "b": 9, "h": 4 } },
    { "id": "trap-area", "g": "mensuration", "name": "Area of a trapezium", "tex": "A = \\tfrac{1}{2}(a + b)h", "expr": "A = 1/2*(a + b)*h", "vars": [{ "s": "A", "n": "area" }, { "s": "a", "n": "one parallel side" }, { "s": "b", "n": "other parallel side" }, { "s": "h", "n": "perpendicular height" }], "ex": { "a": 5, "b": 9, "h": 4 } },
    { "id": "circle-area", "g": "mensuration", "name": "Area of a circle", "tex": "A = \\pi r^2", "expr": "A = pi*r^2", "vars": [{ "s": "A", "n": "area" }, { "s": "r", "n": "radius", "pos": true }], "ex": { "r": 7 } },
    { "id": "circumference", "g": "mensuration", "name": "Circumference of a circle", "tex": "C = 2\\pi r", "expr": "C = 2*pi*r", "vars": [{ "s": "C", "n": "circumference" }, { "s": "r", "n": "radius" }], "ex": { "r": 4.5 } },
    { "id": "arc-deg", "g": "mensuration", "name": "Arc length (angle in degrees)", "tex": "l = \\frac{\\theta}{360} \\times 2\\pi r", "expr": "l = theta/360*2*pi*r", "vars": [{ "s": "l", "n": "arc length" }, { "s": "theta", "n": "angle at the centre", "u": "°" }, { "s": "r", "n": "radius" }], "ex": { "theta": 72, "r": 5 } },
    { "id": "sector-deg", "g": "mensuration", "name": "Area of a sector (angle in degrees)", "tex": "A = \\frac{\\theta}{360} \\times \\pi r^2", "expr": "A = theta/360*pi*r^2", "vars": [{ "s": "A", "n": "sector area" }, { "s": "theta", "n": "angle at the centre", "u": "°" }, { "s": "r", "n": "radius", "pos": true }], "ex": { "theta": 120, "r": 6 } },
    { "id": "arc-rad", "g": "mensuration", "name": "Arc length (angle in radians)", "tex": "s = r\\theta", "expr": "s = r*theta", "vars": [{ "s": "s", "n": "arc length" }, { "s": "r", "n": "radius" }, { "s": "theta", "n": "angle at the centre", "u": "rad" }], "ex": { "r": 8, "theta": 1.2 } },
    { "id": "sector-rad", "g": "mensuration", "name": "Area of a sector (angle in radians)", "tex": "A = \\tfrac{1}{2}r^2\\theta", "expr": "A = 1/2*r^2*theta", "vars": [{ "s": "A", "n": "sector area" }, { "s": "r", "n": "radius", "pos": true }, { "s": "theta", "n": "angle at the centre", "u": "rad" }], "ex": { "r": 5, "theta": 0.8 } },
    { "id": "pythagoras", "g": "mensuration", "name": "Pythagoras’ theorem", "tex": "c^2 = a^2 + b^2", "expr": "c^2 = a^2 + b^2", "vars": [{ "s": "c", "n": "hypotenuse", "pos": true }, { "s": "a", "n": "one shorter side", "pos": true }, { "s": "b", "n": "other shorter side", "pos": true }], "ex": { "a": 5, "b": 12 } },
    { "id": "cuboid-vol", "g": "mensuration", "name": "Volume of a cuboid", "tex": "V = lwh", "expr": "V = l*w*h", "vars": [{ "s": "V", "n": "volume" }, { "s": "l", "n": "length" }, { "s": "w", "n": "width" }, { "s": "h", "n": "height" }], "ex": { "l": 6, "w": 4, "h": 2.5 } },
    { "id": "prism-vol", "g": "mensuration", "name": "Volume of a prism", "tex": "V = Al", "expr": "V = A*l", "vars": [{ "s": "V", "n": "volume" }, { "s": "A", "n": "area of cross-section" }, { "s": "l", "n": "length" }], "ex": { "A": 12, "l": 9 } },
    { "id": "cyl-vol", "g": "mensuration", "name": "Volume of a cylinder", "tex": "V = \\pi r^2 h", "expr": "V = pi*r^2*h", "vars": [{ "s": "V", "n": "volume" }, { "s": "r", "n": "radius", "pos": true }, { "s": "h", "n": "height" }], "ex": { "r": 3, "h": 10 } },
    { "id": "cyl-csa", "g": "mensuration", "name": "Curved surface area of a cylinder", "tex": "A = 2\\pi rh", "expr": "A = 2*pi*r*h", "vars": [{ "s": "A", "n": "curved surface area" }, { "s": "r", "n": "radius" }, { "s": "h", "n": "height" }], "ex": { "r": 3, "h": 10 } },
    { "id": "cone-vol", "g": "mensuration", "name": "Volume of a cone", "tex": "V = \\tfrac{1}{3}\\pi r^2 h", "expr": "V = 1/3*pi*r^2*h", "vars": [{ "s": "V", "n": "volume" }, { "s": "r", "n": "radius", "pos": true }, { "s": "h", "n": "perpendicular height" }], "ex": { "r": 4, "h": 9 } },
    { "id": "cone-csa", "g": "mensuration", "name": "Curved surface area of a cone", "tex": "A = \\pi r l", "expr": "A = pi*r*l", "vars": [{ "s": "A", "n": "curved surface area" }, { "s": "r", "n": "radius" }, { "s": "l", "n": "slant height" }], "ex": { "r": 4, "l": 6 } },
    { "id": "sphere-vol", "g": "mensuration", "name": "Volume of a sphere", "tex": "V = \\tfrac{4}{3}\\pi r^3", "expr": "V = 4/3*pi*r^3", "vars": [{ "s": "V", "n": "volume" }, { "s": "r", "n": "radius", "pos": true }], "ex": { "r": 6 } },
    { "id": "sphere-sa", "g": "mensuration", "name": "Surface area of a sphere", "tex": "A = 4\\pi r^2", "expr": "A = 4*pi*r^2", "vars": [{ "s": "A", "n": "surface area" }, { "s": "r", "n": "radius", "pos": true }], "ex": { "r": 6 } },
    { "id": "pyramid-vol", "g": "mensuration", "name": "Volume of a pyramid", "tex": "V = \\tfrac{1}{3}Ah", "expr": "V = 1/3*A*h", "vars": [{ "s": "V", "n": "volume" }, { "s": "A", "n": "area of base" }, { "s": "h", "n": "perpendicular height" }], "ex": { "A": 36, "h": 8 } },

    { "id": "sine-rule", "g": "trig", "name": "Sine rule", "tex": "\\frac{a}{\\sin A} = \\frac{b}{\\sin B}", "expr": "a/sin(A) = b/sin(B)", "angle": "deg", "vars": [{ "s": "a", "n": "side a" }, { "s": "A", "n": "angle opposite a", "u": "°", "acute": true }, { "s": "b", "n": "side b" }, { "s": "B", "n": "angle opposite b", "u": "°", "acute": true }], "ex": { "A": 40, "b": 9, "B": 65 } },
    { "id": "cosine-rule", "g": "trig", "name": "Cosine rule", "tex": "a^2 = b^2 + c^2 - 2bc\\cos A", "expr": "a^2 = b^2 + c^2 - 2*b*c*cos(A)", "angle": "deg", "vars": [{ "s": "a", "n": "side opposite angle A", "pos": true }, { "s": "b", "n": "side b", "pos": true }, { "s": "c", "n": "side c", "pos": true }, { "s": "A", "n": "angle A", "u": "°", "tri": true }], "ex": { "b": 7, "c": 9, "A": 50 } },
    { "id": "tri-area-sin", "g": "trig", "name": "Area of a triangle using sine", "tex": "\\text{Area} = \\tfrac{1}{2}ab\\sin C", "expr": "S = 1/2*a*b*sin(C)", "angle": "deg", "vars": [{ "s": "S", "n": "area" }, { "s": "a", "n": "side a" }, { "s": "b", "n": "side b" }, { "s": "C", "n": "angle between a and b", "u": "°", "acute": true }], "ex": { "a": 8, "b": 11, "C": 35 } },

    { "id": "gradient", "g": "coord", "name": "Gradient of a line", "tex": "m = \\frac{y_2 - y_1}{x_2 - x_1}", "expr": "m = (y_2 - y_1)/(x_2 - x_1)", "vars": [{ "s": "m", "n": "gradient" }, { "s": "x_1", "n": "x of the first point" }, { "s": "y_1", "n": "y of the first point" }, { "s": "x_2", "n": "x of the second point" }, { "s": "y_2", "n": "y of the second point" }], "ex": { "x_1": 1, "y_1": 2, "x_2": 5, "y_2": 10 } },
    { "id": "line", "g": "coord", "name": "Equation of a straight line", "tex": "y = mx + c", "expr": "y = m*x + c", "vars": [{ "s": "y", "n": "y" }, { "s": "m", "n": "gradient" }, { "s": "x", "n": "x" }, { "s": "c", "n": "y-intercept" }], "ex": { "m": 3, "x": 2, "c": -4 } },
    { "id": "distance", "g": "coord", "name": "Distance between two points", "tex": "d = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}", "expr": "d = sqrt((x_2 - x_1)^2 + (y_2 - y_1)^2)", "vars": [{ "s": "d", "n": "distance" }, { "s": "x_1", "n": "x of the first point" }, { "s": "y_1", "n": "y of the first point" }, { "s": "x_2", "n": "x of the second point" }, { "s": "y_2", "n": "y of the second point" }], "ex": { "x_1": 1, "y_1": 2, "x_2": 4, "y_2": 6 } },
    { "id": "midpoint-x", "g": "coord", "name": "Midpoint (x-coordinate)", "tex": "x_m = \\frac{x_1 + x_2}{2}", "expr": "x_m = (x_1 + x_2)/2", "vars": [{ "s": "x_m", "n": "x of the midpoint" }, { "s": "x_1", "n": "x of the first point" }, { "s": "x_2", "n": "x of the second point" }], "ex": { "x_1": -3, "x_2": 9 } },

    { "id": "discriminant", "g": "algebra", "name": "Discriminant of ax² + bx + c", "tex": "\\Delta = b^2 - 4ac", "expr": "D = b^2 - 4*a*c", "vars": [{ "s": "D", "n": "discriminant" }, { "s": "a", "n": "coefficient of x²" }, { "s": "b", "n": "coefficient of x", "pos": true }, { "s": "c", "n": "constant term" }], "ex": { "a": 2, "b": 7, "c": 3 } },
    { "id": "ap-nth", "g": "algebra", "name": "Arithmetic sequence: nth term", "tex": "u_n = a + (n - 1)d", "expr": "u = a + (n - 1)*d", "vars": [{ "s": "u", "n": "nth term" }, { "s": "a", "n": "first term" }, { "s": "n", "n": "term number" }, { "s": "d", "n": "common difference" }], "ex": { "a": 5, "n": 12, "d": 3 } },
    { "id": "ap-sum", "g": "algebra", "name": "Arithmetic series: sum of n terms", "tex": "S_n = \\frac{n}{2}\\left(2a + (n - 1)d\\right)", "expr": "S = n/2*(2*a + (n - 1)*d)", "vars": [{ "s": "S", "n": "sum of n terms" }, { "s": "n", "n": "number of terms", "pos": true }, { "s": "a", "n": "first term" }, { "s": "d", "n": "common difference" }], "ex": { "n": 20, "a": 3, "d": 4 } },
    { "id": "gp-nth", "g": "algebra", "name": "Geometric sequence: nth term", "tex": "u_n = ar^{n-1}", "expr": "u = a*r^(n - 1)", "vars": [{ "s": "u", "n": "nth term" }, { "s": "a", "n": "first term" }, { "s": "r", "n": "common ratio", "pos": true }, { "s": "n", "n": "term number" }], "ex": { "a": 3, "r": 2, "n": 6 } },
    { "id": "gp-sum", "g": "algebra", "name": "Geometric series: sum of n terms", "tex": "S_n = \\frac{a(1 - r^n)}{1 - r}", "expr": "S = a*(1 - r^n)/(1 - r)", "vars": [{ "s": "S", "n": "sum of n terms" }, { "s": "a", "n": "first term" }, { "s": "r", "n": "common ratio (not 1)", "pos": true }, { "s": "n", "n": "number of terms" }], "ex": { "a": 2, "r": 3, "n": 5 } },
    { "id": "gp-inf", "g": "algebra", "name": "Sum to infinity (|r| < 1)", "tex": "S_\\infty = \\frac{a}{1 - r}", "expr": "S = a/(1 - r)", "vars": [{ "s": "S", "n": "sum to infinity" }, { "s": "a", "n": "first term" }, { "s": "r", "n": "common ratio, between −1 and 1" }], "ex": { "a": 12, "r": 0.25 } },
    { "id": "zscore", "g": "algebra", "name": "Standardised score", "tex": "z = \\frac{x - \\mu}{\\sigma}", "expr": "z = (x - mu)/sigma", "vars": [{ "s": "z", "n": "z-score" }, { "s": "x", "n": "value" }, { "s": "mu", "n": "mean" }, { "s": "sigma", "n": "standard deviation" }], "ex": { "x": 72, "mu": 60, "sigma": 8 } },

    { "id": "simple-interest", "g": "money", "name": "Simple interest", "tex": "I = \\frac{PRT}{100}", "expr": "I = P*R*T/100", "vars": [{ "s": "I", "n": "interest" }, { "s": "P", "n": "principal (amount borrowed or saved)" }, { "s": "R", "n": "rate per year", "u": "%" }, { "s": "T", "n": "time", "u": "years" }], "ex": { "P": 50000, "R": 8, "T": 3 } },
    { "id": "compound", "g": "money", "name": "Compound interest (yearly)", "tex": "A = P\\left(1 + \\frac{r}{100}\\right)^n", "expr": "A = P*(1 + r/100)^n", "vars": [{ "s": "A", "n": "final amount" }, { "s": "P", "n": "principal" }, { "s": "r", "n": "rate per year", "u": "%", "pos": true }, { "s": "n", "n": "number of years" }], "ex": { "P": 10000, "r": 5, "n": 4 } },
    { "id": "pct-change", "g": "money", "name": "Percentage change", "tex": "\\%\\ \\text{change} = \\frac{\\text{new} - \\text{original}}{\\text{original}} \\times 100", "expr": "p = (b - a)/a*100", "vars": [{ "s": "p", "n": "percentage change", "u": "%" }, { "s": "a", "n": "original value" }, { "s": "b", "n": "new value" }], "ex": { "a": 250, "b": 300 } },

    { "id": "speed", "g": "mechanics", "name": "Speed", "tex": "v = \\frac{d}{t}", "expr": "v = d/t", "vars": [{ "s": "v", "n": "speed", "u": "m/s" }, { "s": "d", "n": "distance", "u": "m" }, { "s": "t", "n": "time", "u": "s" }], "ex": { "d": 150, "t": 12 } },
    { "id": "accel", "g": "mechanics", "name": "Acceleration", "tex": "a = \\frac{v - u}{t}", "expr": "a = (v - u)/t", "vars": [{ "s": "a", "n": "acceleration", "u": "m/s²" }, { "s": "v", "n": "final velocity", "u": "m/s" }, { "s": "u", "n": "initial velocity", "u": "m/s" }, { "s": "t", "n": "time", "u": "s" }], "ex": { "v": 25, "u": 5, "t": 4 } },
    { "id": "suvat-1", "g": "mechanics", "name": "Motion: v = u + at", "tex": "v = u + at", "expr": "v = u + a*t", "vars": [{ "s": "v", "n": "final velocity", "u": "m/s" }, { "s": "u", "n": "initial velocity", "u": "m/s" }, { "s": "a", "n": "acceleration", "u": "m/s²" }, { "s": "t", "n": "time", "u": "s" }], "ex": { "u": 3, "a": 2, "t": 5 } },
    { "id": "suvat-2", "g": "mechanics", "name": "Motion: s = ut + ½at²", "tex": "s = ut + \\tfrac{1}{2}at^2", "expr": "s = u*t + 1/2*a*t^2", "vars": [{ "s": "s", "n": "displacement", "u": "m" }, { "s": "u", "n": "initial velocity", "u": "m/s" }, { "s": "t", "n": "time", "u": "s", "pos": true }, { "s": "a", "n": "acceleration", "u": "m/s²" }], "ex": { "u": 2, "t": 4, "a": 3 } },
    { "id": "suvat-3", "g": "mechanics", "name": "Motion: v² = u² + 2as", "tex": "v^2 = u^2 + 2as", "expr": "v^2 = u^2 + 2*a*s", "vars": [{ "s": "v", "n": "final velocity", "u": "m/s", "pos": true }, { "s": "u", "n": "initial velocity", "u": "m/s", "pos": true }, { "s": "a", "n": "acceleration", "u": "m/s²" }, { "s": "s", "n": "displacement", "u": "m" }], "ex": { "u": 4, "a": 2.5, "s": 30 } },
    { "id": "suvat-4", "g": "mechanics", "name": "Motion: s = ½(u + v)t", "tex": "s = \\tfrac{1}{2}(u + v)t", "expr": "s = 1/2*(u + v)*t", "vars": [{ "s": "s", "n": "displacement", "u": "m" }, { "s": "u", "n": "initial velocity", "u": "m/s" }, { "s": "v", "n": "final velocity", "u": "m/s" }, { "s": "t", "n": "time", "u": "s" }], "ex": { "u": 6, "v": 14, "t": 5 } },
    { "id": "newton2", "g": "mechanics", "name": "Newton’s second law", "tex": "F = ma", "expr": "F = m*a", "vars": [{ "s": "F", "n": "resultant force", "u": "N" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "a", "n": "acceleration", "u": "m/s²" }], "ex": { "m": 1200, "a": 2.5 } },
    { "id": "weight", "g": "mechanics", "name": "Weight", "tex": "W = mg", "expr": "W = m*g", "vars": [{ "s": "W", "n": "weight", "u": "N" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "g", "n": "gravitational field strength (9.8 on Earth)", "u": "N/kg", "value": 9.8 }], "ex": { "m": 65, "g": 9.8 } },
    { "id": "momentum", "g": "mechanics", "name": "Momentum", "tex": "p = mv", "expr": "p = m*v", "vars": [{ "s": "p", "n": "momentum", "u": "kg m/s" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "v", "n": "velocity", "u": "m/s" }], "ex": { "m": 0.5, "v": 12 } },
    { "id": "impulse", "g": "mechanics", "name": "Impulse", "tex": "Ft = mv - mu", "expr": "F*t = m*v - m*u", "vars": [{ "s": "F", "n": "force", "u": "N" }, { "s": "t", "n": "time", "u": "s" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "v", "n": "final velocity", "u": "m/s" }, { "s": "u", "n": "initial velocity", "u": "m/s" }], "ex": { "t": 0.2, "m": 0.4, "v": 20, "u": -5 } },
    { "id": "ke", "g": "mechanics", "name": "Kinetic energy", "tex": "E_k = \\tfrac{1}{2}mv^2", "expr": "E_k = 1/2*m*v^2", "vars": [{ "s": "E_k", "n": "kinetic energy", "u": "J" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "v", "n": "speed", "u": "m/s", "pos": true }], "ex": { "m": 2, "v": 6 } },
    { "id": "gpe", "g": "mechanics", "name": "Change in gravitational potential energy", "tex": "\\Delta E_p = mg\\Delta h", "expr": "E_p = m*g*h", "vars": [{ "s": "E_p", "n": "change in potential energy", "u": "J" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "g", "n": "gravitational field strength", "u": "N/kg", "value": 9.8 }, { "s": "h", "n": "change in height", "u": "m" }], "ex": { "m": 3, "g": 9.8, "h": 12 } },
    { "id": "work", "g": "mechanics", "name": "Work done", "tex": "W = Fd", "expr": "W = F*d", "vars": [{ "s": "W", "n": "work done", "u": "J" }, { "s": "F", "n": "force", "u": "N" }, { "s": "d", "n": "distance moved in the direction of the force", "u": "m" }], "ex": { "F": 40, "d": 7.5 } },
    { "id": "power-mech", "g": "mechanics", "name": "Power", "tex": "P = \\frac{W}{t}", "expr": "P = W/t", "vars": [{ "s": "P", "n": "power", "u": "W" }, { "s": "W", "n": "work done or energy transferred", "u": "J" }, { "s": "t", "n": "time", "u": "s" }], "ex": { "W": 1800, "t": 60 } },
    { "id": "pressure", "g": "mechanics", "name": "Pressure", "tex": "p = \\frac{F}{A}", "expr": "p = F/A", "vars": [{ "s": "p", "n": "pressure", "u": "Pa" }, { "s": "F", "n": "force", "u": "N" }, { "s": "A", "n": "area", "u": "m²" }], "ex": { "F": 600, "A": 0.03 } },
    { "id": "liquid-pressure", "g": "mechanics", "name": "Pressure in a liquid", "tex": "\\Delta p = \\rho g \\Delta h", "expr": "p = rho*g*h", "vars": [{ "s": "p", "n": "change in pressure", "u": "Pa" }, { "s": "rho", "n": "density", "u": "kg/m³" }, { "s": "g", "n": "gravitational field strength", "u": "N/kg", "value": 9.8 }, { "s": "h", "n": "change in depth", "u": "m" }], "ex": { "rho": 1000, "g": 9.8, "h": 4 } },
    { "id": "density", "g": "mechanics", "name": "Density", "tex": "\\rho = \\frac{m}{V}", "expr": "rho = m/V", "vars": [{ "s": "rho", "n": "density", "u": "kg/m³" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "V", "n": "volume", "u": "m³" }], "ex": { "m": 2.7, "V": 0.001 } },
    { "id": "moment", "g": "mechanics", "name": "Moment of a force", "tex": "M = Fd", "expr": "M = F*d", "vars": [{ "s": "M", "n": "moment", "u": "N m" }, { "s": "F", "n": "force", "u": "N" }, { "s": "d", "n": "perpendicular distance from the pivot", "u": "m" }], "ex": { "F": 25, "d": 0.4 } },
    { "id": "hooke", "g": "mechanics", "name": "Hooke’s law", "tex": "F = kx", "expr": "F = k*x", "vars": [{ "s": "F", "n": "force", "u": "N" }, { "s": "k", "n": "spring constant", "u": "N/m" }, { "s": "x", "n": "extension", "u": "m" }], "ex": { "k": 40, "x": 0.15 } },

    { "id": "ohm", "g": "electricity", "name": "Ohm’s law", "tex": "V = IR", "expr": "V = I*R", "vars": [{ "s": "V", "n": "potential difference", "u": "V" }, { "s": "I", "n": "current", "u": "A" }, { "s": "R", "n": "resistance", "u": "Ω" }], "ex": { "I": 0.5, "R": 24 } },
    { "id": "power-elec", "g": "electricity", "name": "Electrical power", "tex": "P = IV", "expr": "P = I*V", "vars": [{ "s": "P", "n": "power", "u": "W" }, { "s": "I", "n": "current", "u": "A" }, { "s": "V", "n": "potential difference", "u": "V" }], "ex": { "I": 2, "V": 230 } },
    { "id": "charge", "g": "electricity", "name": "Charge", "tex": "Q = It", "expr": "Q = I*t", "vars": [{ "s": "Q", "n": "charge", "u": "C" }, { "s": "I", "n": "current", "u": "A" }, { "s": "t", "n": "time", "u": "s" }], "ex": { "I": 3, "t": 120 } },
    { "id": "energy-elec", "g": "electricity", "name": "Electrical energy", "tex": "E = IVt", "expr": "E = I*V*t", "vars": [{ "s": "E", "n": "energy transferred", "u": "J" }, { "s": "I", "n": "current", "u": "A" }, { "s": "V", "n": "potential difference", "u": "V" }, { "s": "t", "n": "time", "u": "s" }], "ex": { "I": 2, "V": 12, "t": 300 } },
    { "id": "series-r", "g": "electricity", "name": "Resistors in series", "tex": "R = R_1 + R_2", "expr": "R = R_1 + R_2", "vars": [{ "s": "R", "n": "total resistance", "u": "Ω" }, { "s": "R_1", "n": "first resistor", "u": "Ω" }, { "s": "R_2", "n": "second resistor", "u": "Ω" }], "ex": { "R_1": 4, "R_2": 6 } },
    { "id": "parallel-r", "g": "electricity", "name": "Two resistors in parallel", "tex": "\\frac{1}{R} = \\frac{1}{R_1} + \\frac{1}{R_2}", "expr": "1/R = 1/R_1 + 1/R_2", "vars": [{ "s": "R", "n": "total resistance", "u": "Ω" }, { "s": "R_1", "n": "first resistor", "u": "Ω" }, { "s": "R_2", "n": "second resistor", "u": "Ω" }], "ex": { "R_1": 6, "R_2": 3 } },
    { "id": "transformer", "g": "electricity", "name": "Transformer turns ratio", "tex": "\\frac{V_p}{V_s} = \\frac{N_p}{N_s}", "expr": "V_p/V_s = N_p/N_s", "vars": [{ "s": "V_p", "n": "primary voltage", "u": "V" }, { "s": "V_s", "n": "secondary voltage", "u": "V" }, { "s": "N_p", "n": "turns on the primary coil" }, { "s": "N_s", "n": "turns on the secondary coil" }], "ex": { "V_s": 12, "N_p": 1150, "N_s": 60 } },

    { "id": "wave-speed", "g": "waves", "name": "Wave speed", "tex": "v = f\\lambda", "expr": "v = f*lambda", "vars": [{ "s": "v", "n": "wave speed", "u": "m/s" }, { "s": "f", "n": "frequency", "u": "Hz" }, { "s": "lambda", "n": "wavelength", "u": "m" }], "ex": { "f": 50, "lambda": 6.8 } },
    { "id": "period", "g": "waves", "name": "Period and frequency", "tex": "T = \\frac{1}{f}", "expr": "T = 1/f", "vars": [{ "s": "T", "n": "period", "u": "s" }, { "s": "f", "n": "frequency", "u": "Hz" }], "ex": { "f": 25 } },
    { "id": "snell", "g": "waves", "name": "Refractive index", "tex": "n = \\frac{\\sin i}{\\sin r}", "expr": "n = sin(theta_1)/sin(theta_2)", "angle": "deg", "vars": [{ "s": "n", "n": "refractive index" }, { "s": "theta_1", "n": "angle of incidence i", "u": "°", "acute": true }, { "s": "theta_2", "n": "angle of refraction r", "u": "°", "acute": true }], "ex": { "theta_1": 50, "theta_2": 30 } },
    { "id": "critical-angle", "g": "waves", "name": "Critical angle", "tex": "n = \\frac{1}{\\sin c}", "expr": "n = 1/sin(c)", "angle": "deg", "vars": [{ "s": "n", "n": "refractive index" }, { "s": "c", "n": "critical angle", "u": "°", "acute": true }], "ex": { "c": 42 } },
    { "id": "shc", "g": "waves", "name": "Specific heat capacity", "tex": "\\Delta E = mc\\Delta\\theta", "expr": "E = m*c*theta", "vars": [{ "s": "E", "n": "energy supplied", "u": "J" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "c", "n": "specific heat capacity", "u": "J/(kg °C)" }, { "s": "theta", "n": "temperature change", "u": "°C" }], "ex": { "m": 0.5, "c": 4200, "theta": 30 } },
    { "id": "latent", "g": "waves", "name": "Specific latent heat", "tex": "E = mL", "expr": "E = m*L", "vars": [{ "s": "E", "n": "energy supplied", "u": "J" }, { "s": "m", "n": "mass", "u": "kg" }, { "s": "L", "n": "specific latent heat", "u": "J/kg" }], "ex": { "m": 0.2, "L": 334000 } },
    { "id": "boyle", "g": "waves", "name": "Gas at constant temperature", "tex": "p_1V_1 = p_2V_2", "expr": "p_1*V_1 = p_2*V_2", "vars": [{ "s": "p_1", "n": "starting pressure", "u": "Pa" }, { "s": "V_1", "n": "starting volume", "u": "m³" }, { "s": "p_2", "n": "final pressure", "u": "Pa" }, { "s": "V_2", "n": "final volume", "u": "m³" }], "ex": { "V_1": 0.002, "p_2": 150000, "V_2": 0.0012 } },
    { "id": "kelvin", "g": "waves", "name": "Celsius to kelvin", "tex": "T = \\theta + 273.15", "expr": "T = theta + 273.15", "vars": [{ "s": "T", "n": "temperature", "u": "K" }, { "s": "theta", "n": "temperature", "u": "°C" }], "ex": { "theta": 25 } },

    { "id": "moles-mass", "g": "chemistry", "name": "Amount of substance from mass", "tex": "n = \\frac{m}{M}", "expr": "n = m/M", "vars": [{ "s": "n", "n": "amount", "u": "mol" }, { "s": "m", "n": "mass", "u": "g" }, { "s": "M", "n": "molar mass", "u": "g/mol" }], "ex": { "m": 9, "M": 18 } },
    { "id": "moles-gas", "g": "chemistry", "name": "Gas volume at r.t.p.", "tex": "n = \\frac{V}{24}", "expr": "n = V/24", "vars": [{ "s": "n", "n": "amount", "u": "mol" }, { "s": "V", "n": "gas volume at room temperature and pressure", "u": "dm³" }], "ex": { "V": 6 }, "info": "Uses the molar gas volume of 24 dm³ at room temperature and pressure, as in Cambridge IGCSE and O Level." },
    { "id": "concentration", "g": "chemistry", "name": "Concentration", "tex": "c = \\frac{n}{V}", "expr": "c = n/V", "vars": [{ "s": "c", "n": "concentration", "u": "mol/dm³" }, { "s": "n", "n": "amount", "u": "mol" }, { "s": "V", "n": "volume of solution", "u": "dm³" }], "ex": { "n": 0.05, "V": 0.25 } },
    { "id": "particles", "g": "chemistry", "name": "Number of particles", "tex": "N = nL", "expr": "N = n*L", "vars": [{ "s": "N", "n": "number of particles" }, { "s": "n", "n": "amount", "u": "mol" }, { "s": "L", "n": "Avogadro constant", "u": "per mol", "value": 6.02214076e23 }], "ex": { "n": 0.25, "L": 6.02214076e23 } },
    { "id": "ideal-gas", "g": "chemistry", "name": "Ideal gas equation", "tex": "pV = nRT", "expr": "p*V = n*R*T", "vars": [{ "s": "p", "n": "pressure", "u": "Pa" }, { "s": "V", "n": "volume", "u": "m³" }, { "s": "n", "n": "amount", "u": "mol" }, { "s": "R", "n": "molar gas constant", "u": "J/(mol K)", "value": 8.314 }, { "s": "T", "n": "temperature", "u": "K" }], "ex": { "V": 0.024, "n": 1, "R": 8.314, "T": 298 } }
  ]
}
